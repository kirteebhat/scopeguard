# Public client-accessible configuration (Client & Browser safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Local application URL (Match dev server port, e.g. 3001)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Server-only secrets (NEVER EXPOSE TO CLIENT BUNDLES)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional P1 Integrations (Transactional Email via Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=ScopeGuard <notifications@scopeguard.agency>

